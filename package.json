{
  "name": "yourturn",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node infra/dev.mjs",
    "seed": "node infra/seed/demo.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint": "prettier --check .",
    "lint:openapi": "redocly lint docs/03-architecture/openapi.json",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "secrets": "secretlint \"**/*\" \".env.example\" \".github/**/*\"",
    "check": "npm run lint && npm run lint:openapi && npm run typecheck && npm test && npm run secrets"
  },
  "devDependencies": {
    "@redocly/cli": "2.77.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "secretlint": "13.1.0",
    "typescript": "7.0.2"
  }
}
