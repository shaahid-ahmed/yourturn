{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "types": ["node"],
    "skipLibCheck": false
  },
  "include": [
    "infra/**/*.mjs",
    "tests/**/*.mjs",
    "apps/**/*.ts",
    "services/**/*.ts",
    "packages/**/*.ts"
  ]
}
