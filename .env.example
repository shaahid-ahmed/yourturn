# Bootstrap reads only PORT; blank uses the runtime default only when omitted.
# Set PORT to a valid integer before exporting. No credentials are needed in Phase 0.
PORT=
# Reserved for later approved implementation. Never use live PayPal credentials.
NODE_ENV=
DATABASE_URL=
PAYPAL_ENV=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_ID=
PAYPAL_MERCHANT_ID=
PAYPAL_VENUE_MERCHANT_ID=
PAYPAL_RETURN_URL=
PAYPAL_CANCEL_URL=
SESSION_SECRET=
LLM_API_KEY=
LLM_MODEL=
# US-003: HMAC key for the local sandbox receipt verifier (>= 16 bytes). Sandbox only.
UNSPOKEN_SANDBOX_RECEIPT_KEY=
# US-011: Google Calendar OAuth client (free/busy read + event write scopes only) and the OAuth state HMAC key.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
UNSPOKEN_OAUTH_STATE_KEY=
